{
	"name": "pickit",
	"compatibility_date": "2025-03-01",
	// Better Auth imports node:crypto / node:async_hooks.
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Public origin for Better Auth (OAuth callbacks: <url>/api/auth/callback/<provider>).
	// Secrets: BETTER_AUTH_SECRET, ALLOWED_EMAILS, GOOGLE_CLIENT_ID/SECRET, GITHUB_CLIENT_ID/SECRET.
	"vars": {
		"BETTER_AUTH_URL": "https://pickit.rika66.com"
	},
	"routes": [
		{
			"pattern": "pickit.rika66.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pickit-db",
			"database_id": "73c23ba1-d18b-4ff7-8ce9-e4663b710bb9",
			// Keeps local dev pointing at the existing local sqlite file.
			"preview_database_id": "placeholder-create-with-wrangler",
			"migrations_dir": "migrations"
		}
	],
	// Requires `wrangler r2 bucket create pickit-backups` before deploying.
	// Backups are best-effort: cron.ts skips the backup step if this binding
	// is absent, so remove this block if you don't want the R2 bucket.
	"r2_buckets": [
		{
			"binding": "BACKUPS",
			"bucket_name": "pickit-backups"
		}
	],
	// Daily at 18:00 UTC (02:00 China time): full JSON backup to R2, plus a
	// batch of dead-link checks. See src/cron.ts.
	// Every minute: advance running batch jobs (re-embed / organize) when no
	// settings page is driving them. See src/job-runners.ts.
	"triggers": {
		"crons": [
			"0 18 * * *",
			"* * * * *"
		]
	}
}